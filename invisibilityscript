-- 👤 Author: BlaedOnTop

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Create RemoteEvent if it doesn't exist
local remote = ReplicatedStorage:FindFirstChild("RequestToggleInvisible")
if not remote then
    remote = Instance.new("RemoteEvent")
    remote.Name = "RequestToggleInvisible"
    remote.Parent = ReplicatedStorage
end

-----------------------------------------------------
-- 🔸 SERVER HANDLER (real FE invisibility)
-----------------------------------------------------
local playerState = {}

remote.OnServerEvent:Connect(function(player)
    local char = player.Character
    if not char then return end

    local invisible = not (playerState[player] or false)
    playerState[player] = invisible

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Transparency = invisible and 1 or 0
            part.CanCollide = not invisible
        elseif part:IsA("Decal") or part:IsA("Texture") then
            part.Transparency = invisible and 1 or 0
        elseif part:IsA("ParticleEmitter") or part:IsA("Trail") then
            part.Enabled = not invisible
        end
    end
end)

Players.PlayerRemoving:Connect(function(player)
    playerState[player] = nil
end)

-----------------------------------------------------
-- 🔸 GUI CREATION (automatically adds to every player)
-----------------------------------------------------
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function()
        task.wait(1)

        local playerGui = player:WaitForChild("PlayerGui", 5)
        if not playerGui then return end

        -- Create ScreenGui
        local screenGui = Instance.new("ScreenGui")
        screenGui.Name = "InvisibilityGui"
        screenGui.ResetOnSpawn = false
        screenGui.Parent = playerGui

        -- Create Button
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(0, 160, 0, 45)
        button.Position = UDim2.new(0.05, 0, 0.8, 0)
        button.Text = "Invisibility: OFF"
        button.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        button.TextColor3 = Color3.new(1, 1, 1)
        button.Font = Enum.Font.GothamBold
        button.TextSize = 18
        button.Parent = screenGui

        -- Create LocalScript dynamically
        local localScript = Instance.new("LocalScript")
        localScript.Source = [[
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local remote = ReplicatedStorage:WaitForChild("RequestToggleInvisible")
            local button = script.Parent
            local invisible = false

            button.MouseButton1Click:Connect(function()
                invisible = not invisible
                remote:FireServer()
                if invisible then
                    button.Text = "Invisibility: ON"
                    button.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
                else
                    button.Text = "Invisibility: OFF"
                    button.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                end
            end)
        ]]
        localScript.Parent = button
    end)
end)
